# 数据库配置
DATABASE_URL="file:./data/dev.db"

# JWT配置（生产环境必须设置至少32位的强密钥，切勿使用默认值！）
JWT_SECRET=""
JWT_REFRESH_SECRET=""
JWT_EXPIRES_IN="1h"
JWT_REFRESH_EXPIRES_IN="7d"

# Redis配置（可选）
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASSWORD=""
REDIS_DB="0"

# 邮件服务配置（可选）
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Mio Diary <noreply@miodiary.com>"

# 系统配置
NODE_ENV="development"
PORT="3000"

# 文件上传配置
UPLOAD_DIR="uploads"
MAX_FILE_SIZE="5242880"

# 安全配置
BCRYPT_ROUNDS="12"

# ==================== 新增配置 ====================

# CORS配置（生产环境必填，多个域名用逗号分隔）
# 示例: CORS_ORIGINS="https://your-domain.com,https://www.your-domain.com"
CORS_ORIGINS=""

# 前端URL（用于生成邮件、分享链接中的URL）
# 示例: FRONTEND_URL="https://your-domain.com"
FRONTEND_URL="http://localhost:3000"

# 服务器绑定配置（默认localhost，生产环境建议0.0.0.0）
HOST="localhost"

# 邮件TLS验证（开发环境可设为false禁用TLS证书验证，生产环境必须为true）
EMAIL_REJECT_UNAUTHORIZED="true"

# 配置加密密钥（生产环境必须设置！）
# CONFIG_ENCRYPTION_KEY 必须至少32个字符
# CONFIG_ENCRYPTION_IV 必须至少16个字符
CONFIG_ENCRYPTION_KEY=""
CONFIG_ENCRYPTION_IV=""